MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGODB_DB_NAME=hearth
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
AUTH_SIGNING_SECRET=
AUTH_KEY_ID=current
AUTH_ISSUER=hearth
AUTH_AUDIENCE=hearth-api
AUTH_ALLOWED_ORIGINS=["https://localhost:5173"]
AUTH_COOKIE_SAMESITE=lax
# During key rotation, set both values, then remove after 15 minutes + 30 seconds:
# AUTH_PREVIOUS_KEY_ID=old-key-id
# AUTH_PREVIOUS_SECRET=previous-secret
